# ==========================================
# CONFIGURACIÓN DE MONGODB ATLAS
# ==========================================
# 
# INSTRUCCIONES PARA OBTENER TU MONGODB_URI:
# 
# 1. Ve a https://www.mongodb.com/cloud/atlas/register
# 2. Crea una cuenta gratuita (o inicia sesión)
# 3. Crea un nuevo Cluster (elige la opción FREE M0)
# 4. En "Security" > "Database Access":
#    - Crea un usuario con contraseña
#    - Guarda las credenciales
# 5. En "Security" > "Network Access":
#    - Agrega tu IP actual
#    - Para desarrollo: 0.0.0.0/0 (permite todas las IPs)
#    - Para producción: agrega solo las IPs de tu servidor
# 6. En "Deployment" > "Database" > "Connect":
#    - Selecciona "Connect your application"
#    - Copia la URI de conexión
#    - Reemplaza <password> con tu contraseña real
#    - Reemplaza <database> con: bocatto_valley
#
# Ejemplo de URI:
# mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/bocatto_valley?retryWrites=true&w=majority

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bocatto_valley?retryWrites=true&w=majority

# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# JWT (JSON WEB TOKEN) - Para Autenticación
# ==========================================
# Genera una clave secreta fuerte. Puedes usar:
# En Node.js: require('crypto').randomBytes(64).toString('hex')
# O un generador online: https://randomkeygen.com/

JWT_SECRET=tu_clave_secreta_super_segura_cambiame_en_produccion
JWT_EXPIRE=7d

# ==========================================
# CORS - Dominios permitidos
# ==========================================
# En desarrollo: localhost
# En producción: tu dominio de frontend (ej: https://bocatto-valley.netlify.app)

FRONTEND_URL=http://localhost:5500
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ==========================================
# CONFIGURACIÓN DE COOKIES
# ==========================================
COOKIE_SECRET=otra_clave_secreta_para_cookies_cambiame_tambien
